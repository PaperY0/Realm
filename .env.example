# Copy to .env.local for the local Demo. Never commit the real API key.
# start/demo/test load this file through the Node 18-compatible project preload.
TEXT_BASE_URL=https://api.openai-next.com/v1
MEDIA_BASE_URL=https://api.openai-next.com/v1
AI_GATEWAY_API_KEY=
TEXT_MODEL=gpt-5.6-sol
TEXT_GENERATION_ATTEMPTS=2
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=720x1280
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=png
IMAGE_TIMEOUT_MS=180000
IMAGE_GENERATION_CONCURRENCY=3
IMAGE_GENERATION_ATTEMPTS=2
VIDEO_MODEL=doubao-seedance-2-0-fast-260128
